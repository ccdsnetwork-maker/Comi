"use client"

import { FormEvent, useState } from "react"
import {
  Facebook,
  Instagram,
  Mail,
  MapPin,
  MessageCircle,
  Phone,
  Send,
  Youtube,
  Music2,
  SendHorizontal,
} from "lucide-react"
import { motion } from "framer-motion"

const phones = [
  "08101684398",
  "09013754164",
  "08139318139",
]

const socials = [
  {
    name: "Facebook",
    href: "https://facebook.com/comiconnects",
    icon: Facebook,
  },
  {
    name: "Instagram",
    href: "https://instagram.com/comiconnects",
    icon: Instagram,
  },
  {
    name: "TikTok",
    href: "https://www.tiktok.com/@comiconnects",
    icon: Music2,
  },
  {
    name: "YouTube",
    href: "https://youtube.com/@comiconnects",
    icon: Youtube,
  },
  {
    name: "Telegram",
    href: "https://t.me/comiconects",
    icon: SendHorizontal,
  },
]

export default function ContactPage() {
  const [loading, setLoading] = useState(false)
  const [status, setStatus] = useState("")

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()

    setLoading(true)
    setStatus("")

    const form = event.currentTarget
    const data = new FormData(form)

    const payload = {
      name: String(data.get("name") || "").trim(),
      email: String(data.get("email") || "").trim(),
      phone: String(data.get("phone") || "").trim(),
      subject: String(data.get("subject") || "").trim(),
      message: String(data.get("message") || "").trim(),
    }

    try {
      const response = await fetch("/api/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      })

      const result = await response.json()

      if (!response.ok) {
        throw new Error(result?.error || "Unable to send message.")
      }

      form.reset()
      setStatus(
        "Your message has been sent successfully. Our team will get back to you."
      )
    } catch (error) {
      setStatus(
        error instanceof Error
          ? error.message
          : "Something went wrong. Please try again."
      )
    } finally {
      setLoading(false)
    }
  }

  return (
    <main className="min-h-screen overflow-hidden bg-white">
      {/* HERO */}
      <section className="bg-[#061B49] px-5 pb-14 pt-28 text-white sm:px-8 lg:px-12">
        <div className="mx-auto max-w-6xl">
          <motion.div
            initial={{ opacity: 0, y: 30 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.7 }}
            className="max-w-3xl"
          >
            <p className="text-sm font-semibold uppercase tracking-[0.25em] text-[#F4C542]">
              Contact Us
            </p>

            <h1 className="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
              We&apos;d love to hear from you.
            </h1>

            <p className="mt-5 max-w-2xl text-base leading-7 text-white/85 sm:text-lg">
              Have a question, prayer request, ministry enquiry or simply want
              to connect with us? Send us a message and our team will respond.
            </p>
          </motion.div>
        </div>
      </section>

      {/* CONTACT FORM */}
      <section className="px-5 py-12 sm:px-8 lg:px-12 lg:py-16">
        <div className="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1.15fr_0.85fr]">

          <motion.div
            initial={{ opacity: 0, y: 25 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6 }}
            className="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-[#061B49]/5 sm:p-8"
          >
            <p className="text-sm font-semibold uppercase tracking-widest text-[#177DDC]">
              Send a Message
            </p>

            <h2 className="mt-2 text-2xl font-bold text-[#061B49] sm:text-3xl">
              How can we help?
            </h2>

            <form
              onSubmit={handleSubmit}
              className="mt-7 space-y-4"
            >
              <div className="grid gap-4 sm:grid-cols-2">
                <input
                  name="name"
                  required
                  placeholder="Full name"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-[#177DDC] focus:bg-white"
                />

                <input
                  name="email"
                  type="email"
                  required
                  placeholder="Email address"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-[#177DDC] focus:bg-white"
                />
              </div>

              <div className="grid gap-4 sm:grid-cols-2">
                <input
                  name="phone"
                  placeholder="Phone number"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-[#177DDC] focus:bg-white"
                />

                <input
                  name="subject"
                  required
                  placeholder="Subject"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-[#177DDC] focus:bg-white"
                />
              </div>

              <textarea
                name="message"
                required
                rows={6}
                placeholder="Write your message..."
                className="w-full resize-none rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-[#177DDC] focus:bg-white"
              />

              <button
                type="submit"
                disabled={loading}
                className="flex w-full items-center justify-center gap-2 rounded-2xl bg-[#061B49] px-5 py-3.5 font-semibold text-white transition hover:bg-[#177DDC] disabled:cursor-not-allowed disabled:opacity-60"
              >
                <Send size={18} />

                {loading ? "Sending..." : "Send Message"}
              </button>

              {status && (
                <p
                  aria-live="polite"
                  className="rounded-2xl bg-[#061B49] px-4 py-3 text-sm font-medium text-white"
                >
                  {status}
                </p>
              )}
            </form>
          </motion.div>

          {/* CONTACT DETAILS */}
          <motion.div
            initial={{ opacity: 0, x: 25 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6 }}
            className="rounded-3xl bg-[#061B49] p-6 text-white shadow-xl sm:p-8"
          >
            <p className="text-sm font-semibold uppercase tracking-widest text-[#F4C542]">
              Reach Us
            </p>

            <h2 className="mt-2 text-2xl font-bold sm:text-3xl">
              Connect with us
            </h2>

            <div className="mt-7 space-y-3">

              <a
                href="mailto:comiconnects@gmail.com"
                className="flex items-center gap-3 rounded-2xl bg-white/10 p-4 transition hover:bg-white/15"
              >
                <Mail className="shrink-0 text-[#F4C542]" />

                <span className="text-sm text-white">
                  comiconnects@gmail.com
                </span>
              </a>

              {phones.map((phone) => (
                <a
                  key={phone}
                  href={`tel:${phone}`}
                  className="flex items-center gap-3 rounded-2xl bg-white/10 p-4 transition hover:bg-white/15"
                >
                  <Phone className="shrink-0 text-[#F4C542]" />

                  <span className="text-sm text-white">
                    {phone}
                  </span>
                </a>
              ))}

              <a
                href="https://wa.me/2348101684398"
                target="_blank"
                rel="noreferrer"
                className="flex items-center gap-3 rounded-2xl bg-[#25D366] p-4 font-semibold text-white transition hover:scale-[1.01]"
              >
                <MessageCircle />

                <span>
                  Chat with us on WhatsApp
                </span>
              </a>
            </div>

            {/* SOCIAL ICONS */}
            <div className="mt-7 border-t border-white/15 pt-6">
              <p className="mb-4 text-sm font-semibold text-white">
                Follow our platforms
              </p>

              <div className="flex flex-wrap gap-3">
                {socials.map((social) => {
                  const Icon = social.icon

                  return (
                    <a
                      key={social.name}
                      href={social.href}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={social.name}
                      title={social.name}
                      className="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:-translate-y-1 hover:bg-[#177DDC]"
                    >
                      <Icon size={20} strokeWidth={2} />
                    </a>
                  )
                })}
              </div>
            </div>

            <div className="mt-7 flex items-start gap-3 rounded-2xl bg-white/10 p-4">
              <MapPin className="mt-0.5 shrink-0 text-[#F4C542]" />

              <p className="text-sm leading-6 text-white/85">
                Continental Outreach Ministries Int&apos;l and its ministries
                are committed to reaching lives, strengthening people and
                advancing God&apos;s work.
              </p>
            </div>
          </motion.div>

        </div>
      </section>
    </main>
  )
}
